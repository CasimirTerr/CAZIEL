<?xml version="1.0"?>
<!--
  KX-1: a warehouse mobile manipulator used as Caziel's reference robot.
  Differential-drive base with a 4-axis arm and a parallel gripper.
  Masses and limits are representative of this class of robot, not a specific product.
-->
<robot name="kx1">

  <!-- ===================== base ===================== -->
  <link name="base_footprint"/>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.18"/>
      <mass value="92.0"/>
      <inertia ixx="4.1" ixy="0" ixz="0" iyy="5.6" iyz="0" izz="7.9"/>
    </inertial>
    <visual><geometry><box size="0.82 0.58 0.32"/></geometry></visual>
    <collision><geometry><box size="0.82 0.58 0.32"/></geometry></collision>
  </link>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 0.09"/>
  </joint>

  <link name="left_wheel">
    <inertial><mass value="3.1"/><inertia ixx="0.012" ixy="0" ixz="0" iyy="0.012" iyz="0" izz="0.02"/></inertial>
    <visual><geometry><cylinder radius="0.09" length="0.05"/></geometry></visual>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="left_wheel"/>
    <origin xyz="0 0.31 0"/><axis xyz="0 1 0"/>
    <limit effort="60" velocity="24.0"/>
  </joint>

  <link name="right_wheel">
    <inertial><mass value="3.1"/><inertia ixx="0.012" ixy="0" ixz="0" iyy="0.012" iyz="0" izz="0.02"/></inertial>
    <visual><geometry><cylinder radius="0.09" length="0.05"/></geometry></visual>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="right_wheel"/>
    <origin xyz="0 -0.31 0"/><axis xyz="0 1 0"/>
    <limit effort="60" velocity="24.0"/>
  </joint>

  <link name="caster">
    <inertial><mass value="1.0"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/><child link="caster"/>
    <origin xyz="-0.33 0 -0.06"/>
  </joint>

  <link name="lidar_link">
    <inertial><mass value="0.8"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/><child link="lidar_link"/>
    <origin xyz="0.36 0 0.2"/>
  </joint>

  <link name="dock_camera_link">
    <inertial><mass value="0.3"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/></inertial>
  </link>
  <joint name="dock_camera_joint" type="fixed">
    <parent link="base_link"/><child link="dock_camera_link"/>
    <origin xyz="0.4 0 0.24"/>
  </joint>

  <!-- ===================== arm ===================== -->
  <link name="arm_mount">
    <inertial><mass value="1.2"/><inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/></inertial>
  </link>
  <joint name="arm_mount_joint" type="fixed">
    <parent link="base_link"/><child link="arm_mount"/>
    <origin xyz="0.12 0 0.16"/>
  </joint>

  <link name="shoulder_link">
    <inertial><mass value="3.0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.008"/></inertial>
  </link>
  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="arm_mount"/><child link="shoulder_link"/>
    <origin xyz="0 0 0.05"/><axis xyz="0 0 1"/>
    <limit lower="-3.05" upper="3.05" effort="150" velocity="1.6"/>
  </joint>

  <link name="upper_arm_link">
    <inertial><mass value="3.2"/><inertia ixx="0.04" ixy="0" ixz="0" iyy="0.04" iyz="0" izz="0.006"/></inertial>
  </link>
  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link"/><child link="upper_arm_link"/>
    <origin xyz="0 0 0.10"/><axis xyz="0 1 0"/>
    <limit lower="-2.2" upper="2.2" effort="150" velocity="1.6"/>
  </joint>

  <link name="forearm_link">
    <inertial><mass value="2.4"/><inertia ixx="0.025" ixy="0" ixz="0" iyy="0.025" iyz="0" izz="0.004"/></inertial>
  </link>
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/><child link="forearm_link"/>
    <origin xyz="0.35 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.6" upper="2.6" effort="80" velocity="2.0"/>
  </joint>

  <link name="wrist_link">
    <inertial><mass value="1.2"/><inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/></inertial>
  </link>
  <joint name="wrist_joint" type="revolute">
    <parent link="forearm_link"/><child link="wrist_link"/>
    <origin xyz="0.30 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-3.05" upper="3.05" effort="28" velocity="2.6"/>
  </joint>

  <link name="tool0"/>
  <joint name="tool_flange_joint" type="fixed">
    <parent link="wrist_link"/><child link="tool0"/>
    <origin xyz="0.12 0 0"/>
  </joint>

  <link name="gripper_link">
    <inertial><mass value="0.9"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="gripper_mount_joint" type="fixed">
    <parent link="tool0"/><child link="gripper_link"/>
    <origin xyz="0.05 0 0"/>
  </joint>

  <link name="gripper_finger_left">
    <inertial><mass value="0.08"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial>
  </link>
  <joint name="gripper_finger_joint" type="prismatic">
    <parent link="gripper_link"/><child link="gripper_finger_left"/>
    <origin xyz="0.04 0.02 0"/><axis xyz="0 1 0"/>
    <limit lower="0" upper="0.04" effort="40" velocity="0.1"/>
  </joint>

  <link name="gripper_tcp"/>
  <joint name="gripper_tcp_joint" type="fixed">
    <parent link="gripper_link"/><child link="gripper_tcp"/>
    <origin xyz="0.08 0 0"/>
  </joint>
</robot>
